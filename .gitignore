# ---------------------------------------------------------------------------
# ESP-IDF (firmware/)
# ---------------------------------------------------------------------------
# Build output
firmware/build/
# Component Manager downloads (reproducible via dependencies.lock + idf_component.yml)
firmware/managed_components/
# Generated per-machine configuration (defaults live in sdkconfig.defaults)
firmware/sdkconfig
firmware/sdkconfig.old
firmware/sdkconfig.*.old
# Local caches / compile database
firmware/.cache/
firmware/compile_commands.json

