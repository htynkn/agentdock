# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# ---------------------------------------------------------------------------
# ESP-IDF (firmware/)
# ---------------------------------------------------------------------------
# Build output
firmware/build/
# Component Manager downloads (reproducible via dependencies.lock + idf_component.yml)
firmware/managed_components/
# Generated per-machine configuration (defaults live in sdkconfig.defaults)
firmware/sdkconfig
firmware/sdkconfig.old
firmware/sdkconfig.*.old
# Local caches / compile database
firmware/.cache/
firmware/compile_commands.json

# ---------------------------------------------------------------------------
# Node.js (pi-plugin/)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
dist/
coverage/
.nyc_output/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Promo video (promo/) — 宣传片渲染工程
# ---------------------------------------------------------------------------
# 高精度网格：prep_meshes.py 从 hardware/enclosure CAD 确定性重建
promo/assets/
# 渲染中间产物：4K 帧序列 / 音轨 / events.json（./build.sh --capture 重新生成）
promo/render/
# 最终成片：mp4 / gif / poster（./build.sh 重新编码，不入库）
promo/out/
# Python
promo/__pycache__/
promo/.python-version

# ---------------------------------------------------------------------------
# Environment / credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Logs / temporary files
# ---------------------------------------------------------------------------
*.log
tmp/
*.tmp

# npm pack output
*.tgz
