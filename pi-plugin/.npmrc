# Makes `npm version` create tags named pi-plugin-vX.Y.Z, which is what
# .github/workflows/release-pi-plugin.yml publishes on. Without the prefix a
# plain vX.Y.Z tag could belong to the firmware, hardware or promo package in
# this monorepo. Not included in the published tarball (see package.json files).
tag-version-prefix=pi-plugin-v
