# PCB 3D model exports: the canonical PCB.step is tracked; dated EasyEDA
# exports (PCB.step is a copy of the latest one) stay local.
# Re-export from EasyEDA Pro: 文件 → 导出 → STEP → copy to pcb/PCB.step
pcb/*.step
pcb/*.stp
!pcb/PCB.step

# Python
__pycache__/
*.pyc
.venv/

# Build outputs (regenerated by `uv run render.py` / `animate.py` / CI artifacts)
enclosure/output/
# Rendered previews: PNG/GIF/MP4 generated by render.py & animate.py
enclosure/render/

# macOS
.DS_Store
